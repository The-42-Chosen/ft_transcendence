# allow to proxify for grafana websocket 
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Logs d'erreur
error_log /var/log/nginx/error.log notice;
error_log /var/log/nginx/error.file.log warn;

# Logs d'acces en JSON pour NGINX
log_format json_logs escape=json '{'
    '"time":"$time_iso8601",'
    '"client_ip":"$remote_addr",'
    '"method":"$request_method",'
    '"path":"$request_uri",'
    '"status":"$status",'
    '"bytes":"$body_bytes_sent",'
    '"request_time":"$request_time",'
    '"referer":"$http_referer",'
    '"user_agent":"$http_user_agent"'
'}';

server {
    listen 80;
    server_name _;

    access_log /var/log/nginx/access.json.log json_logs;

    return 301 https://$host:${NGINX_SSL_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    access_log /var/log/nginx/access.json.log json_logs;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $next_upstream     http://next:3000;
    set $realtime_upstream http://realtime:3001;
    set $mailpit_upstream  http://mailpit:8025;

    location / {
        proxy_pass $next_upstream;

        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    # Socket.IO (service realtime) : WebSocket + long-polling.
    location /socket.io/ {
        proxy_pass $realtime_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 1h;
    }

    # Grafana, servi en sous-chemin
    location /grafana/ {
        proxy_pass http://grafana:3000;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    # Kibana, servi en sous-chemin derriere le proxy SSL
    location /kibana/ {
        proxy_pass http://kibana:5601;

        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    location = /kibana {
        return 301 /kibana/;
    }

    # Mailpit (boite des mails d'alerte), servi en sous-chemin. Le login
    # (basic auth) est exige par mailpit lui-meme, UI comme API.
    location /mailpit/ {
        proxy_pass $mailpit_upstream;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    location = /mailpit {
        return 301 https://$http_host/mailpit/;
    }
}

# intern location for nginx-exporter
server {
    listen 8081;
    server_name _;

    location /stub_status {
        stub_status;
    }
}